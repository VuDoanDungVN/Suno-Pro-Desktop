{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suno-pro-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-24",
  // Bắt buộc cho @cloudflare/puppeteer (dùng node:buffer nội bộ) — thiếu cờ này sẽ lỗi runtime.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Tạo bằng: wrangler d1 create suno-pro-db  (rồi dán database_id thật vào đây)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "suno-pro-db",
      "database_id": "d04a65e1-c40a-44a1-8495-99528b9f57b7",
      "migrations_dir": "./migrations"
    }
  ],
  // Browser Rendering — dùng cho tự động hoá Suno Studio (gửi lệnh AI, Export → Full Song)
  // ngay trên server thay vì mở cửa sổ trên máy người dùng. Yêu cầu Workers Paid (xem
  // https://developers.cloudflare.com/browser-rendering/platform/limits/).
  "browser": { "binding": "BROWSER" },
  // Hàng đợi công bằng cho automate-reverse khi nhiều người dùng cùng lúc — xem
  // src/studio-queue-do.ts (lớp StudioQueueDO export từ src/index.ts). Tag migration mới
  // (v3, không dùng lại v1-studio-queue) vì tag đó đã từng tạo RỒI xoá trên worker staging ở một
  // nhánh thử nghiệm trước — dùng lại tag cũ có thể bị Cloudflare coi là "đã áp dụng", không tạo
  // lại class.
  "durable_objects": {
    "bindings": [{ "name": "STUDIO_QUEUE", "class_name": "StudioQueueDO" }]
  },
  "migrations": [{ "tag": "v3-studio-queue-reintroduce", "new_sqlite_classes": ["StudioQueueDO"] }],

  // Môi trường thử nghiệm — deploy: npx wrangler deploy --env staging
  // Worker riêng (suno-pro-worker-staging) + D1 riêng (suno-pro-db-staging), không đụng tới
  // dữ liệu/khách hàng thật của production.
  "env": {
    "staging": {
      "name": "suno-pro-worker-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "suno-pro-db-staging",
          "database_id": "d23bca55-bfc2-4ce4-a62b-f579dc37991b",
          "migrations_dir": "./migrations"
        }
      ],
      "browser": { "binding": "BROWSER" },
      "durable_objects": {
        "bindings": [{ "name": "STUDIO_QUEUE", "class_name": "StudioQueueDO" }]
      }
    }
  }
}
