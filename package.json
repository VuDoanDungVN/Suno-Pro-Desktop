{
  "name": "suno-pro",
  "version": "2.4.4",
  "description": "Suno Pro 2.4.4",
  "main": "electron/main.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "package:mac": "electron-packager . \"Suno Pro\" --overwrite --platform=darwin --arch=arm64,x64 --icon=build/icon.icns --out=out --app-bundle-id=com.sunopro.app --prune=true --asar --ignore=\"^/out($|/)\" --ignore=\"^/dist/assets/.*\\.map$\" --ignore=\"^/worker($|/)\" --ignore=\"^/docs($|/)\" --ignore=\"^/scripts($|/)\" --ignore=\"^/\\.git($|/)\" --ignore=\"^/README\\.md$\" --ignore=\"^/\\.gitignore$\"",
    "package:win": "node scripts/package-win.js && node scripts/set-win-icon.js",
    "package:all": "npm run package:mac && npm run package:win"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-packager": "^17.1.2",
    "resedit": "^3.1.0"
  }
}
